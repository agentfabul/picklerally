{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        ".validate": "$roomCode.matches(/^PKL-[0-9]{3}$/)",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() == auth.uid) || (data.exists() && data.child('host').val() == auth.uid))",
          ".validate": "newData.hasChildren(['host', 'mode', 'status', 'createdAt']) && newData.child('host').isString() && newData.child('mode').isString() && newData.child('status').isString() && newData.child('createdAt').isNumber()"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && ($uid == auth.uid || root.child('rooms').child($roomCode).child('meta').child('host').val() == auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'team', 'characterId', 'connected']) && newData.child('uid').val() == $uid && newData.child('team').isNumber() && newData.child('characterId').isString() && newData.child('connected').isBoolean()"
          }
        },
        "inputs": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && $uid == auth.uid",
            ".validate": "newData.hasChildren(['uid', 'sequence', 'targetX', 'targetY', 'timestampMs']) && newData.child('uid').val() == $uid && newData.child('sequence').isNumber() && newData.child('targetX').isNumber() && newData.child('targetY').isNumber()"
          }
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomCode).child('meta').child('host').val() == auth.uid",
          ".validate": "newData.hasChildren(['tick', 'ballX', 'ballY', 'ballZ', 'scoreHost', 'scoreGuest']) && newData.child('tick').isNumber()"
        }
      }
    }
  }
}
